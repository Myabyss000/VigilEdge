# ThreatLoom Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME=ThreatLoom
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8443
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# Database
DATABASE_URL=sqlite+aiosqlite:///./threatloom.db
# For production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/threatloom

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# GeoIP (MaxMind)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Retention (days)
RETENTION_HOT_DAYS=7
RETENTION_WARM_DAYS=30
RETENTION_COLD_DAYS=365

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/threatloom.log

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8443"]

# Firewall Integration (VigilEdge WAF on port 5000)
FIREWALL_WEBHOOK_ENABLED=true
FIREWALL_WEBHOOK_URL=http://localhost:5000/soc-webhook
FIREWALL_WEBHOOK_SECRET=change-this-shared-secret
FIREWALL_HEALTH_URL=http://localhost:5000
FIREWALL_STARTUP_CHECK=true
FIREWALL_STARTUP_RETRIES=5
FIREWALL_STARTUP_RETRY_DELAY=3

# Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_MIN_SEVERITY=HIGH
# Example: Slack/Discord/custom webhook receiver
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
BROWSER_NOTIFICATIONS_ENABLED=true

# Detection engine
DETECTION_SCAN_INTERVAL_SECONDS=3
DETECTION_LOOKBACK_SECONDS=15

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
